# Copy to .env and adjust for local development. Never commit .env.

# PostgreSQL
POSTGRES_USER=starterapp
POSTGRES_PASSWORD=starterapp
POSTGRES_DB=starterapp
DATABASE_URL=postgres://starterapp:starterapp@postgres:5432/starterapp?sslmode=disable

# Required, no default. Base64 key (at least 32 decoded bytes) that signs the
# operator session cookie. Generate one with:  openssl rand -base64 32
SESSION_SIGNING_SECRET=

# Backend listen address (default :8080).
# LISTEN_ADDR=:8080

# Frontend: server-side URL the SvelteKit server uses to reach the backend.
BACKEND_URL=http://backend:8080

# Optional modules (optional/): leave empty to run without them.
# Outgoing SMTP relay for the email provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_IMPLICIT_TLS=false
